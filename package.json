{
  "name": "trailerhero",
  "version": "1.5.0",
  "description": "A Decky plugin that turns Steam Big Picture hero art into cinematic game trailers.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "python scripts/package-release.py",
    "test": "node --check dist/index.js && python -m py_compile main.py"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam",
    "trailer",
    "big-picture"
  ],
  "author": "LoZazaMastro",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
